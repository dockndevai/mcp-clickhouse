# --- Connection -------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TIMEOUT_MS=30000

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
CLICKHOUSE_MODE=read-only
# Comma-separated database allowlist. Empty = all.
CLICKHOUSE_DATABASE_ALLOWLIST=
# Databases that can be read but never mutated. Default: system, information_schema.
CLICKHOUSE_PROTECTED_DATABASES=system,information_schema
# Destructive statements (DROP/TRUNCATE/DELETE/…) require this in addition to admin mode.
CLICKHOUSE_ALLOW_DELETE=false
# Validate + log writes without executing them.
CLICKHOUSE_DRY_RUN=false
# Cap on rows returned by read queries.
CLICKHOUSE_MAX_ROWS=1000
# Emit a JSON audit line to stderr per guarded operation.
CLICKHOUSE_AUDIT_LOG=true
