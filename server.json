{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dockndevai/mcp-clickhouse",
  "description": "ClickHouse query & management for AI agents — SQL-classified read/write/destructive gating.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-clickhouse",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dockndevai/mcp-clickhouse",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLICKHOUSE_URL",
          "description": "ClickHouse HTTP endpoint.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "CLICKHOUSE_USER",
          "description": "ClickHouse user (prefer a read-only user).",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "CLICKHOUSE_PASSWORD",
          "description": "ClickHouse password.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "CLICKHOUSE_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
