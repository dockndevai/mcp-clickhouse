{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.dockndevai/mcp-clickhouse",
  "description": "Model Context Protocol server for ClickHouse — query and manage databases with SQL-classification-based security modes and access-control flags.",
  "status": "active",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-clickhouse",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "npm",
      "registry_base_url": "https://registry.npmjs.org",
      "identifier": "mcp-clickhouse",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environment_variables": [
        {
          "name": "CLICKHOUSE_URL",
          "description": "ClickHouse HTTP endpoint.",
          "is_required": false,
          "is_secret": false
        },
        {
          "name": "CLICKHOUSE_USER",
          "description": "ClickHouse user (prefer a read-only user).",
          "is_required": false,
          "is_secret": false
        },
        {
          "name": "CLICKHOUSE_PASSWORD",
          "description": "ClickHouse password.",
          "is_required": false,
          "is_secret": true
        },
        {
          "name": "CLICKHOUSE_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "is_required": false,
          "is_secret": false
        }
      ]
    }
  ]
}
